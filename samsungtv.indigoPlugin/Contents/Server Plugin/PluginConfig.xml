<?xml version="1.0"?>
<PluginConfig>
	<Field id="refresh_frequency" type="textfield" defaultValue="30">
		<Label>Enter API Refresh Frequency in Seconds:</Label>
	</Field>
	<Field id="debugLevel" type="menu" defaultValue="off">
		<Label>Debug Logging:</Label>
		<List>
			<Option value="off">Critical</Option>
			<Option value="debug">Debug</Option>
			<Option value="detailed">Detailed State Logging</Option>
		</List>
	</Field>

	<Field id="sepIpTracking" type="separator"/>
	<Field id="ipTracking" type="checkbox" defaultValue="true">
		<Label>Detect IP address changes:</Label>
		<Description>update new IPs to device automatically</Description>
	</Field>
	<Field id="ipSearchInterval" type="menu" defaultValue="15" visibleBindingId="ipTracking" visibleBindingValue="true" alwaysUseInDialogHeightCalc="true">
		<Label>Look for a missing TV every:</Label>
		<List>
			<Option value="15">15 minutes</Option>
			<Option value="30">30 minutes</Option>
			<Option value="45">45 minutes</Option>
			<Option value="60">60 minutes</Option>
		</List>
	</Field>
	<Field id="ipTrackingNote" type="label" fontSize="small" fontColor="darkgray" visibleBindingId="ipTracking" visibleBindingValue="true" alwaysUseInDialogHeightCalc="true">
		<Label>A TV is only "missing" while it isn't answering, and it can only be found while it's turned on. The plugin also looks right away when a different device shows up at a TV's address, or right after a Turn On.</Label>
	</Field>
</PluginConfig>
